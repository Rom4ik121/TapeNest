# TapeNest — shared environment variables (NAMES only; fill values in .env).
# Copy: cp .env.example .env   — .env is git-ignored. Never commit secrets.
# Infra defaults for local dev live in deploy/docker-compose.dev.yml.

# ── general ───────────────────────────────────────────────────────────────
# dev | staging | prod
APP_ENV=
# debug | info | warn | error
LOG_LEVEL=

# ── Telegram (bot-service, api-gateway auth) ─────────────────────────────
# from @BotFather (secret)
TELEGRAM_BOT_TOKEN=
# public HTTPS URL of bot-service webhook (dev: <ngrok>/tg/webhook, set by tools/dev)
TELEGRAM_WEBHOOK_URL=
# X-Telegram-Bot-Api-Secret-Token (secret; [A-Za-z0-9_-]{16,256})
TELEGRAM_WEBHOOK_SECRET=
# route bot-service listens on (default /tg/webhook)
TELEGRAM_WEBHOOK_PATH=
# default https://api.telegram.org (tests point it at a fake)
TELEGRAM_API_BASE=
# HTTPS URL of the WavePlayer mini app
MINIAPP_WAVEPLAYER_URL=

# ── dev tunnel (tools/dev/miniapp-up.sh) ──────────────────────────────────
# secret
NGROK_AUTHTOKEN=
# optional static domain, e.g. name.ngrok-free.app
NGROK_DOMAIN=

# ── bot-service ───────────────────────────────────────────────────────────
# default 8081
BOT_SERVICE_PORT=
# dev: Vite proxies /tg → this (default http://127.0.0.1:8081)
BOT_SERVICE_URL=
# setWebhook + setChatMenuButton + setMyCommands on start (default true)
BOT_SETUP_ON_START=
# menu button label (default WavePlayer)
BOT_MENU_BUTTON_TEXT=
# api-gateway base URL used by bot-service / Vite proxy (default http://127.0.0.1:8080)
GATEWAY_URL=
# bot-service → gateway request timeout (default 5s)
GATEWAY_TIMEOUT=
# shared service-to-service bearer for /internal/v1/* (secret)
INTERNAL_API_TOKEN=

# ── api-gateway / auth ────────────────────────────────────────────────────
# default 8080
API_GATEWAY_PORT=
# apply golang-migrate migrations on start (default true)
MIGRATE_ON_START=
# honour X-Forwarded-For / X-Real-IP (true behind nginx/ngrok/Vite proxy)
TRUST_PROXY_HEADERS=
# secret, ≥ 32 random bytes
JWT_SECRET=
# e.g. 15m
JWT_ACCESS_TTL=
# e.g. 720h
JWT_REFRESH_TTL=
# e.g. 24h
INITDATA_TTL=
# comma-separated mini app origins
CORS_ALLOWED_ORIGINS=
# per-user limit for authenticated routes
RATE_LIMIT_RPS=
RATE_LIMIT_BURST=
# per-IP limit for /api/v1/auth/* (defaults 1 rps, burst 20)
AUTH_RATE_LIMIT_RPS=
AUTH_RATE_LIMIT_BURST=
# upstream services; empty = not deployed → honest 501 NOT_IMPLEMENTED
MUSIC_SERVICE_URL=
DOWNLOAD_SERVICE_URL=
# proxy timeout (default 10s)
UPSTREAM_TIMEOUT=
# comma-separated Telegram ids with admin role
ADMIN_TELEGRAM_IDS=

# ── PostgreSQL 16 ─────────────────────────────────────────────────────────
POSTGRES_USER=
# secret
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
# postgres://user:pass@host:5432/db?sslmode=disable
DATABASE_URL=
# empty = primary only (spec §5.4)
DB_REPLICA_URL=
# integration tests (go test) — separate DB; skipped when empty
TEST_DATABASE_URL=

# ── Redis 7.4 ─────────────────────────────────────────────────────────────
REDIS_PORT=
# redis://host:6379/0
REDIS_URL=
# integration tests — separate logical DB, e.g. redis://127.0.0.1:6379/15
TEST_REDIS_URL=

# ── MinIO (S3) ────────────────────────────────────────────────────────────
MINIO_ROOT_USER=
# secret
MINIO_ROOT_PASSWORD=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=
# host:9000
S3_ENDPOINT=
# secret
S3_ACCESS_KEY=
# secret
S3_SECRET_KEY=
S3_USE_SSL=
S3_BUCKET_MEDIA=
S3_BUCKET_MUSIC=
# ≤ 1h (spec §9)
PRESIGN_TTL=
# public origin that proxies /<bucket>/… to MinIO (presigned links for files > 50 MB); dev: the ngrok URL
S3_PUBLIC_URL=
# MinIO lifecycle for downloaded media (spec §5.3 cache)
MEDIA_RETENTION=

# ── Navidrome (music streaming) ───────────────────────────────────────────
NAVIDROME_PORT=
NAVIDROME_URL=
NAVIDROME_USER=
# secret
NAVIDROME_PASSWORD=
# host path mounted to /music
MUSIC_DIR=

# ── music-service ─────────────────────────────────────────────────────────
MUSIC_SERVICE_PORT=
# worker /healthz, /readyz
MUSIC_WORKER_PORT=
# HMAC key for signed stream/cover URLs (secret, ≥ 32 bytes)
STREAM_SIGNING_KEY=
# stream URL lifetime, ≤ 1h (spec §9)
STREAM_URL_TTL=
# optional absolute origin for stream URLs (empty = same-origin relative /api/v1/stream/…)
STREAM_PUBLIC_BASE=
# Navidrome → catalog sync interval (default 10m)
CATALOG_SYNC_INTERVAL=
# track_popularity refresh interval (default 5m)
POPULARITY_REFRESH_INTERVAL=
# reco-service base URL (empty = My Wave uses the local heuristic only)
RECO_SERVICE_URL=
# per-batch reco timeout (default 400ms), breaker: consecutive failures / open time
RECO_TIMEOUT=
RECO_BREAKER_FAILURES=
RECO_BREAKER_OPEN=

# ── reco-service (My Wave recommender, ADR 0010) ─────────────────────────
RECO_SERVICE_PORT=
# worker /healthz, /readyz
RECO_WORKER_PORT=
# ffmpeg binary for audio analysis (default ffmpeg in PATH)
FFMPEG_BIN=
# parallel audio analyses (default 2)
RECO_ANALYZE_WORKERS=
# catalog copy + analysis interval (default 10m), CF/ALS training interval (default 15m)
RECO_CATALOG_INTERVAL=
RECO_TRAIN_INTERVAL=
# how often the API checks for a new model version (default 20s)
RECO_MODEL_POLL=
# JSON overrides of ranking weights, e.g. {"cf":1.2,"epsilon":0.1}
RECO_WEIGHTS=
# one-off history backfill window in days (default 90)
RECO_BACKFILL_DAYS=
# idempotency keys retention (default 720h)
RECO_INGESTED_RETENTION=


# ── YouTube Music catalog (ADR 0012, amended by 0014) ────────────────────
# youtube = search/playback besides the local Navidrome library.
# library-only: set MUSIC_SOURCES=library
MUSIC_SOURCES=
# yt-dlp binary. Playback passes player_client=android (the web client is bot-blocked).
YTDLP_BIN=

# ── download-service ──────────────────────────────────────────────────────
# comma-separated proxy URLs (secret)
PROXY_POOL_DATACENTER=
PROXY_POOL_RESIDENTIAL=
PROXY_POOL_MOBILE=
DOWNLOAD_WORKER_CONCURRENCY=
# alert threshold, e.g. 12h
COOKIES_MAX_AGE=
DOWNLOAD_SERVICE_PORT=
DOWNLOAD_WORKER_PORT=
YTDLP_PATH=
# yt-dlp --js-runtimes (YouTube signature solving), e.g. deno
YTDLP_JS_RUNTIMES=
FFMPEG_LOCATION=
DOWNLOAD_TMP_DIR=
DOWNLOAD_MAX_HEIGHT=
# Bot API upload cap (bytes); bigger files → presigned link
TELEGRAM_UPLOAD_LIMIT=
# per-user quotas (spec §5.3 fairness/§11)
DOWNLOAD_QUOTA_ACTIVE=
DOWNLOAD_QUOTA_DAILY=

# ── observability ─────────────────────────────────────────────────────────
PROMETHEUS_PORT=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
# secret
GRAFANA_ADMIN_PASSWORD=
NGINX_PORT=

# ── frontend (Vite; per-app .env in apps/*) ───────────────────────────────
VITE_API_URL=
# per-domain MSW mocks: empty = dev default "music" (real auth, mocked catalog), all|none|auth,music
VITE_USE_MOCKS=
# tunnel host for HMR over wss
VITE_DEV_PUBLIC_HOST=
# bot username for the "open in Telegram" link
VITE_BOT_USERNAME=
