# api-gateway origin (without /api/v1). Empty = same origin (dev: Vite proxies /api; prod: nginx).
VITE_API_URL=
# MSW mocks per API domain (dev only):
#   (empty)          — dev default: real gateway auth and real /cinema/* (streaming-service)
#   cinema           — MSW catalog (offline UI)
#   all | true       — everything mocked (offline)
#   none | false     — no mocks (also the default of production builds)
VITE_USE_MOCKS=
# Optional bot username (without @) for the "Open in Telegram" link.
VITE_BOT_USERNAME=tapenest_bot
# Optional public tunnel host for HMR over wss (tools/dev/lib.sh passes it).
VITE_DEV_PUBLIC_HOST=
