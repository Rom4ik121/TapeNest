# api-gateway origin (without /api/v1). Empty = same origin: in dev Vite proxies
# /api → GATEWAY_URL (default http://127.0.0.1:8080), so it also works through
# the single ngrok URL; in prod nginx routes /api to the gateway.
VITE_API_URL=
# MSW mocks per API domain (dev only):
#   (empty) / none  — dev + prod default since stage 3: real api-gateway + music-service
#   music           — real gateway auth, mocked tracks/playlists/wave/events (no music-service needed)
#   all | true      — everything mocked (offline, no backend needed)
#   auth,music      — explicit list
VITE_USE_MOCKS=
# Optional bot username (without @) for the "Open in Telegram" link.
VITE_BOT_USERNAME=tapenest_bot
# Optional: public HTTPS tunnel host (e.g. xyz.ngrok-free.app) for HMR over wss.
# tools/dev/lib.sh passes it automatically.
VITE_DEV_PUBLIC_HOST=
